{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/sync-repos.sh",
            "timeout": 60,
            "statusMessage": "Ziehe neusten Stand (focuseditor + schreibwerkstatt)…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/mark-changed.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/verify-build.sh",
            "timeout": 900,
            "statusMessage": "Verifiziere Tests (und ggf. App-Store-Target)…"
          }
        ]
      }
    ]
  }
}
